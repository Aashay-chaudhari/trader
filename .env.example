# Copy to .env locally. Never commit populated credentials or notification topics.
# Broker endpoint is fixed to Alpaca PAPER by the runtime.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
NTFY_TOPIC=

TRADER_START_DATE=2026-10-30
TRADER_EXECUTION=false
TRADER_PUBLISH=true
TRADER_RESEARCH_MODEL=gpt-6.1-sol
TRADER_DECISION_MODEL=gpt-6.1-sol
TRADER_LIGHT_MODEL=gpt-6-luna
TRADER_MAINTENANCE_MODEL=gpt-6.1-sol
# Optional absolute CLI path if codex is not available on the scheduler PATH.
# TRADER_CODEX_BIN=
